{
  "name": "Laravel DevContainer",

  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/ScrumboardAPI2",

  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20"
    }
  },

  "postCreateCommand": "composer install && npm install",

  "forwardPorts": [8000, 5173, 3306]
}
